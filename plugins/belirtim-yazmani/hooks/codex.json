{
  "description": "Local Codex BYW hooks requiring native trust review. No cloud interception claim.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^byw-reader-[abc]$|^byw-preparation$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event PreCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event PostCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/profile_hooks.py\" --host codex --event Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
