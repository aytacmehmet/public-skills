  bolumler:
    "1.1":
      alanlar:
        gel_id: GEL-MM-014
        baslik: Onaylı satınalma siparişinin tedarikçi portalına gönderimi ve gönderim izleme
        modul: Satınalma (MM-PUR)
        sistem: S/4HANA Cloud Public Edition
        yaklasim: Developer (ABAP Cloud)
        clean_core: A
        cc_gerekce: —
        oncelik: Yüksek
        karmasiklik: Orta
        danisman: Örnek Danışman
        abap: Örnek ABAP Geliştirici
        ui5: Örnek UI5 Geliştirici
    "1.2":
      alanlar:
        odata_versiyon: V4
        backend_modeli: RAP managed
        draft: Hayır; kayıtlar yalnız aksiyonla değişir
        ui_yaklasimi: Fiori elements
        binding_tipi: OData V4 – UI
      satirlar[2]:
        - [6]: SRV-01,ZUI_PO_SEND_LOG_O4,Z,OData V4 – UI,—,Gönderim izleme uygulamasının servisi
        - [6]: SRV-02,I_PurchaseOrderAPI01,SAP,"CDS view, sistem içi okuma",C1,Onaylı sipariş başlıklarının okunması
    "2.1":
      alanlar:
        ozet: "Onaylanan satınalma siparişleri tedarikçiye satınalmacı tarafından elle, PDF ekli e-posta ile iletilir. Gönderimin yapılıp yapılmadığı sistemde izlenmez."
        sorun: ASIS-03 adımında gönderim kişiye bağlıdır ve unutulabilir; ASIS-04 adımında gönderim durumu sistemde görünmez.
        etki: Sipariş başına yaklaşık 4 dk; ayda yaklaşık 15 unutulan gönderim; haftada yaklaşık 2 saat takip
        ornek: "4500001234 numaralı sipariş 12.05.2026'da onaylandı, tedarikçiye 14.05.2026'da iletildi; teslimat 2 gün gecikti."
        hacim: "Yaklaşık 120 sipariş/gün, şirket kodu 1710"
      satirlar[4]:
        - [6]: ASIS-01,Satınalmacı,Siparişi oluşturur ve onaya gönderir,Manage Purchase Orders (F0842A),Hayır,—
        - [6]: ASIS-02,Onaycı,Siparişi onaylar,My Inbox,Hayır,—
        - [6]: ASIS-03,Satınalmacı,Onaylı siparişin PDF'ini e-posta ile tedarikçiye gönderir,F0842A ve e-posta istemcisi,Evet,Sipariş başına yaklaşık 4 dk; ayda yaklaşık 15 unutulan gönderim
        - [6]: ASIS-04,Satınalmacı,Gönderimin yapılıp yapılmadığını e-posta kutusundan takip eder,E-posta istemcisi,Evet,Haftada yaklaşık 2 saat; durum sistemde görünmüyor
    "2.2":
      alanlar:
        cozum_ozeti: Onayı tamamlanan siparişler 5 dakikada bir çalışan bir application job ile tedarikçi portalına REST üzerinden gönderilir. Her gönderim bir log kaydı üretir; satınalmacı bir Fiori elements uygulamasından durumu izler ve hatalı gönderimi yeniden başlatır.
        teknoloji: "ABAP Cloud, RAP managed BO, Application Job, Communication Arrangement (giden HTTP), Fiori elements List Report, Application Log"
        cozdugu_sorun: "ASIS-03, ASIS-04"
      satirlar[4]:
        - [6]: REQ-01,Satınalma siparişinin onayı tamamlandığında sistem siparişi 5 dakika içinde tedarikçi portalına gönderir.,Olay,ASIS-03,Given onaylı sipariş 4500001234; When gönderim job'u çalışır; Then portal 201 döner ve log kaydı Status = 'S' olur.,Must
        - [6]: REQ-02,"Portal 5xx yanıtı verirse ya da 10 saniye içinde yanıt vermezse sistem gönderimi 1, 5 ve 15 dakika sonra yeniden dener ve üçüncü denemeden sonra kaydı Hata durumuna alır.",İstenmeyen,ASIS-03,Given portal 500 döner; When üç deneme tamamlanır; Then log kaydı Status = 'E' olur ve MSG-03 yazılır.,Must
        - [6]: REQ-03,"Sistem her gönderim denemesini sipariş numarası, deneme sayısı ve HTTP koduyla log tablosuna yazar.",Her zaman,ASIS-04,Given bir gönderim denemesi; When deneme biter; Then izleme uygulamasında deneme sayısı 1 artmış görünür.,Must
        - [6]: REQ-04,Gönderim kaydı Hata durumundayken satınalmacı 'Yeniden gönder' aksiyonunu çalıştırdığında sistem kaydı Kuyrukta durumuna alır.,Bileşik,ASIS-04,Given Status = 'E' kayıt ve yetkili kullanıcı; When 'Yeniden gönder' çalışır; Then Status = 'Q' olur ve deneme sayısı 0'lanır.,Should
    "2.3":
      satirlar[4]:
        - [7]: SC-01,Onaylı siparişin ilk gönderimi,"Application job, 5 dk'da bir",Sipariş onaylı; tedarikçi portal kapsamında,"Seç, anahtarı kontrol et, JSON oluştur, POST et, log yaz",Kayıt yoksa job MSG-01 ile biter,"REQ-01, REQ-03"
        - [7]: SC-02,Gönderilmiş siparişin değişmesi,Sipariş değişti ve yeniden onaylandı,Önceki sürüm Status = 'S',Yeni LastChangeDateTime yeni anahtar üretir; sipariş yeniden gönderilir,Aynı sürüm ikinci kez seçilirse MSG-06 ile atlanır,REQ-01
        - [7]: SC-03,Portal hatası ve tekrar,Portal 5xx döndü ya da 10 sn'de yanıt vermedi,Log kaydı Status = 'Q',"1, 5 ve 15 dk sonra yeniden dene",Üçüncü denemeden sonra Status = 'E'; 4xx yanıtında tekrar denenmez,REQ-02
        - [7]: SC-04,Elle yeniden gönderim,Kullanıcı 'Yeniden gönder' aksiyonunu çalıştırır,Status = 'E'; kullanıcı şirket kodu için yetkili,"Yetkiyi kontrol et, Status = 'Q' yap","Yetki yoksa MSG-07, kayıt değişmez",REQ-04
    "2.5":
      alanlar:
        kapsam_ici: Şirket kodu 1710'da onayı tamamlanan standart satınalma siparişlerinin tedarikçi portalına gönderimi ve gönderimin izlenmesi.
        kapsam_siniri: Şirket kodu 1710; belge türü NB; kanal yalnız tedarikçi portalı REST arayüzü
      satirlar[3]:
        - [7]: DEP-01,Bağımlılık,Portal REST uç noktası POST /api/v1/orders test ortamında açık olmalı,Portal ekibi,Doğrulandı,10.05.2026,"3.10"
        - [7]: ASM-01,Varsayım,Portal aynı siparişi Idempotency-Key başlığıyla tekilleştirir ve yinelenen istekte 409 döner,Portal ekibi,Doğrulandı,10.05.2026,"3.9"
        - [7]: OOS-01,Kapsam dışı,Çerçeve sözleşme çağrı siparişleri ve hizmet siparişleri gönderilmez,SAP danışmanı,Doğrulandı,08.05.2026,"2.2"
    "2.4":
      satirlar[1]:
        - [5]: D-01,Akış,"SC-01, SC-03",Bu bölümdeki Mermaid diyagramı,v1 · 14.05.2026
      mermaid: "flowchart LR\n  A[\"STEP-02 Siparişleri oku\"] --> B{\"STEP-03 Anahtar var mı\"}\n  B -- Evet --> C[\"MSG-06 Atla\"]\n  B -- Hayır --> D[\"STEP-04 JSON ve log\"]\n  D --> E[\"STEP-05 POST\"]\n  E --> F[\"STEP-06 Durumu yaz\"]"
    "3.1":
      satirlar[3]:
        - [6]: PRE-01,Ana veri,Tedarikçi 17300001; portal kapsamı işaretli,Test,SAP danışmanı,Evet
        - [6]: PRE-02,Uyarlama,Satınalma siparişi esnek iş akışı etkin; şirket kodu 1710,Test,SAP danışmanı,Evet
        - [6]: PRE-03,İletişim düzenlemesi,ZCS_PO_SUPPLIER_PORTAL için communication arrangement ve portal OAuth istemcisi,Test,Sistem / yayın sorumlusu,Hayır
    "3.4":
      alanlar:
        yon: Giden
        protokol: REST / JSON
        tetikleyici: "Application job ZMM_PO_SEND_JCE, 5 dakikada bir"
        hacim: Yaklaşık 120 sipariş/gün; en büyük mesaj yaklaşık 200 kalem
        comm_scenario: ZCS_PO_SUPPLIER_PORTAL
      satirlar[6]:
        - [9]: MAP-01,I_PurchaseOrderAPI01,PurchaseOrder,JSON gövdesi,orderNumber,CHAR(10) → string,Evet,Birebir; baştaki sıfırlar korunur,"4500001234 → \"4500001234\""
        - [9]: MAP-02,I_PurchaseOrderAPI01,Supplier,JSON gövdesi,supplierId,CHAR(10) → string,Evet,Baştaki sıfırlar atılır,"0017300001 → \"17300001\""
        - [9]: MAP-03,I_PurchaseOrderAPI01,DocumentCurrency,JSON gövdesi,currency,CUKY(5) → string,Evet,ISO kodu birebir,"EUR → \"EUR\""
        - [9]: MAP-04,I_PurchaseOrderItemAPI01,PurchaseOrderItem,JSON gövdesi,"items[].lineNumber",NUMC(5) → number,Evet,Sayıya çevrilir,00010 → 10
        - [9]: MAP-05,I_PurchaseOrderItemAPI01,OrderQuantity,JSON gövdesi,"items[].quantity","QUAN(13,3) → number",Evet,Ondalık ayırıcı nokta,"120,000 → 120.0"
        - [9]: MAP-06,I_PurchaseOrderItemAPI01,NetPriceAmount,JSON gövdesi,"items[].netPrice","CURR(11,2) → number",Evet,Ondalık ayırıcı nokta; para birimi MAP-03'ten,"12,50 → 12.5"
    "3.3":
      alanlar:
        floorplan: List Report + Object Page
        floorplan_gerekce: "Kayıt listesi, filtreleme ve tek kayıt ayrıntısı yeterli; özel düzen gerekmiyor."
        semantic_object: PurchaseOrderSendLog-monitor
        launchpad: Satınalma / Sipariş izleme / Gönderim izleme
        cihaz_dil: "Masaüstü ve tablet; TR, EN"
        anahtar_kullanici: "İzinli: kolon ve filtre uyarlaması"
      satirlar[5]:
        - [8]: UI-01,Liste,Filtre,Şirket kodu,Her zaman görünür; zorunlu değil,@UI.selectionField,—,Varsayılan 1710
        - [8]: UI-02,Liste,Kolon,Durum,"Salt okunur; 'E' kırmızı, 'S' yeşil, 'Q' nötr","@UI.lineItem, criticality",—,"Durum sözlüğü ST-01, ST-02, ST-03"
        - [8]: UI-03,Liste,Kolon,Deneme sayısı,Salt okunur,@UI.lineItem,—,—
        - [8]: UI-04,Liste,Aksiyon,Yeniden gönder,Yalnız Status = 'E' satırlarda etkin; Write erişimi yoksa pasif,"@UI.lineItem type #FOR_ACTION, dataAction 'resend'",STEP-07,Çoklu seçim desteklenir
        - [8]: UI-05,Nesne sayfası,Sekme,Deneme geçmişi,Salt okunur,"@UI.facet, lineItem",—,Deneme zamanı ve HTTP kodu
    "3.5":
      satirlar[7]:
        - [9]: STEP-01,"1",Sipariş kaydı öncesi; onay tamamlandı,Portal bayrağını 'X' yap,"MM_PUR_S4_PO_MODIFY_HEADER, ZMM_PO_HDR_PORTAL_FLAG, YY1_PortalSend_PDH",Sipariş başlığı → bayrak 'X',—,Standart sipariş kaydıyla birlikte kalıcı olur,"REQ-01, SC-01"
        - [9]: STEP-02,"2",Job başladı,"ReleaseIsNotCompleted = boş, portal bayrağı 'X' ve LastChangeDateTime > son başarılı çalışma zamanı olan sipariş başlıklarını oku","I_PurchaseOrderAPI01, ZCL_MM_PO_SEND_JOB",Son çalışma zamanı → sipariş listesi,Kayıt yok → MSG-01,Değişiklik yok,"REQ-01, SC-01, SC-02"
        - [9]: STEP-03,"3",Her sipariş için,İdempotency anahtarını (PurchaseOrder + LastChangeDateTime) log'da ara; varsa siparişi atla,ZR_PO_SEND_LOG,Anahtar → var / yok,Anahtar var → MSG-06,Değişiklik yok,"REQ-01, SC-02"
        - [9]: STEP-04,"4",Anahtar yok,"Kalemleri oku; MAP-01, MAP-02, MAP-03, MAP-04, MAP-05, MAP-06 eşlemesiyle JSON oluştur; log kaydını Status = 'Q' ile yarat","I_PurchaseOrderItemAPI01, ZR_PO_SEND_LOG",Sipariş → JSON ve log kaydı,Zorunlu alan boş → MSG-04,Log kaydı RAP save sequence içinde kalıcı olur; MSG-04 durumunda kayıt yaratılmaz,"REQ-01, REQ-03, SC-01"
        - [9]: STEP-05,"5",Log kaydı Status = 'Q',JSON'u Idempotency-Key başlığıyla portala POST et; zaman aşımı 10 sn,"ZCL_MM_PO_SEND_CLIENT, CL_WEB_HTTP_CLIENT_MANAGER, ZCS_PO_SUPPLIER_PORTAL",JSON → HTTP yanıtı,4xx → MSG-03; 5xx ya da zaman aşımı → MSG-05,Çağrı veritabanını değiştirmez,"REQ-01, REQ-02, SC-01, SC-03"
        - [9]: STEP-06,"6",Yanıt alındı,"201 ya da 409 ise Status = 'S' ve MSG-02; 4xx ise 'E'; 5xx ya da zaman aşımında deneme sayısını artır, üçüncü denemeden sonra 'E' ve MSG-03; sonucu application log'a yaz","ZR_PO_SEND_LOG, CL_BALI_LOG, ZMM_PO_SEND",HTTP yanıtı → durum ve log,—,Durum güncellemesi RAP save sequence içinde kalıcı olur,"REQ-02, REQ-03, SC-01, SC-03"
        - [9]: STEP-07,"7",Kullanıcı UI-04 aksiyonunu çalıştırdı; Status = 'E',AUTH-01 yetkisini kontrol et; Status = 'Q' yap ve deneme sayısını 0'la,"ZBP_R_PO_SEND_LOG, ZMM_POSND",Log kaydı 'E' → 'Q',Yetki yok → MSG-07,RAP save sequence; yetki hatasında değişiklik yok,"REQ-04, SC-04"
