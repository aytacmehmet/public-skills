additional_rules[10]{id,mechanism,test_or_workflow,evidence_scope}:
  V3-1,role-owned consultant questions,test_consultant_only_questions_sorted_and_scored; test_mixed_or_unowned_technical_question_not_sent_to_consultant,Synthetic local regression
  V3-2,at most three grounded scored options; no approval,test_options_cap_range_and_information_without_invented_choices,Synthetic local regression
  V3-3,bounded developer decisions; distinct coding readiness,test_bounded_technical_open_is_deliverable_but_not_coding_ready; test_architecture_missing_context_blocks,Synthetic local regression
  V3-4,short-name-prefixed files and manifest roles,test_all_file_prefixes_manifest_roles_and_standalone_contract,Synthetic local regression
  V3-5,local file/document/list/text pointer closure,test_missing_file_document_list_pointer_and_free_text_ref_block,Synthetic local regression
  V3-6,separate linked ZIPs; atomic all-member publication,test_separate_zip_batch_is_atomic_and_contracts_self_contained; test_blocked_partner_and_missing_member_publish_nothing,Synthetic local regression
  V3-7,input/dependency hashes invalidate only affected planning units,test_incremental_reuse_dependency_closure_and_stale_result_rejection,Planning cache only; no measured token or latency savings
  V3-8,legacy references readable; no new 2.0 export,test_old_handoff_is_readable_baseline_but_not_new_export,Synthetic local regression
  V3-9,selected technical context closes architecture and input-reference graph,test_selected_context_includes_technical_architecture_and_reference_closure,Synthetic local regression
  V3-10,saved-ZIP local mockup and TOON text pointer closure,test_offline_mockup_cannot_reference_a_missing_local_asset; test_missing_file_document_list_pointer_and_free_text_ref_block,Synthetic local regression
