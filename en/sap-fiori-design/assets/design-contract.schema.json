{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sap-fiori-design:design-contract:2.0",
  "title": "SAP Fiori Design Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schemaVersion",
    "project",
    "context",
    "architecture",
    "informationArchitecture",
    "fieldsAndActions",
    "states",
    "responsive",
    "visualSystem",
    "accessibility",
    "backendEvidence",
    "dataContract",
    "verification",
    "traceability",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$schemaVersion": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "language",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "tr",
            "en"
          ]
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "png",
              "interactive",
              "code"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact",
              "status",
              "source"
            ],
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "assumed",
                  "unknown",
                  "blocked"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "targetSystem": {
          "type": "object",
          "required": [
            "product",
            "edition",
            "release",
            "ui5Runtime",
            "fioriGuidelineVersion",
            "launchContext"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "edition": {
              "type": "string",
              "minLength": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            },
            "ui5Runtime": {
              "type": "string",
              "minLength": 1
            },
            "fioriGuidelineVersion": {
              "type": "string",
              "minLength": 1
            },
            "launchContext": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "targetSystem",
        "evidence"
      ]
    },
    "architecture": {
      "type": "object",
      "required": [
        "framework",
        "floorplan",
        "layout",
        "frontendLanguage",
        "serviceProtocol",
        "decisionRationale"
      ],
      "properties": {
        "framework": {
          "enum": [
            "freestyle-sapui5-prototype",
            "freestyle-sapui5",
            "fiori-elements-odata-v2",
            "fiori-elements-odata-v4"
          ]
        },
        "floorplan": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "frontendLanguage": {
          "enum": [
            "javascript",
            "typescript",
            "metadata"
          ]
        },
        "serviceProtocol": {
          "enum": [
            "odata-v2",
            "odata-v4"
          ]
        },
        "minUI5Version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "draft": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "decisionRationale": {
          "type": "string",
          "minLength": 1
        },
        "alternativesRejected": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "informationArchitecture": {
      "type": "object"
    },
    "fieldsAndActions": {
      "type": "object"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$"
          }
        }
      }
    },
    "stateExceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason"
        ],
        "properties": {
          "state": {
            "enum": [
              "initial",
              "populated",
              "empty",
              "error",
              "no-auth"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "responsive": {
      "type": "object",
      "required": [
        "breakpoints"
      ],
      "properties": {
        "breakpoints": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "S",
                  "M",
                  "L",
                  "XL"
                ]
              }
            }
          }
        }
      }
    },
    "visualSystem": {
      "type": "object"
    },
    "accessibility": {
      "type": "object",
      "required": [
        "persistentLabels",
        "keyboardComplete",
        "visibleFocus",
        "highContrast"
      ],
      "properties": {
        "persistentLabels": {
          "type": "boolean"
        },
        "keyboardComplete": {
          "type": "boolean"
        },
        "visibleFocus": {
          "type": "boolean"
        },
        "highContrast": {
          "type": "boolean"
        }
      }
    },
    "backendEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "status",
        "contractFile",
        "sha256",
        "sourceMode",
        "packageName",
        "complete",
        "activeSourcesOnly",
        "gaps"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not-provided",
            "partial",
            "source-verified"
          ]
        },
        "contractFile": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "sourceMode": {
          "enum": [
            "unknown",
            "local-export",
            "live-adt-snapshot"
          ]
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "activeSourcesOnly": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dataContract": {
      "type": "object",
      "required": [
        "authorization",
        "serverCapabilities"
      ],
      "properties": {
        "authorization": {
          "const": "backend-enforced"
        },
        "serverCapabilities": {
          "type": "object"
        },
        "initialSelect": {
          "type": "array"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "states",
        "commands",
        "accessibilityEvidence"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibilityEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "method",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1
    }
  }
}
