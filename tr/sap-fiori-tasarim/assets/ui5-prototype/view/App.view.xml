<mvc:View
  controllerName="__APP_ID__.controller.App"
  displayBlock="true"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns="sap.m">
  <f:DynamicPage
    id="mainDynamicPage"
    headerExpanded="true"
    preserveHeaderStateOnScroll="true"
    toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title id="pageTitle" text="{i18n>pageTitle}" level="H1" />
        </f:heading>
        <f:expandedContent>
          <Text id="pageSubtitle" text="{i18n>pageSubtitle}" />
        </f:expandedContent>
        <f:actions>
          <Button
            id="createButton"
            text="{i18n>createButtonText}"
            type="Emphasized"
            enabled="{ui>/actionsEnabled}"
            press=".onCreate" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader id="mainHeader" pinnable="true">
        <VBox id="filterArea" class="sapUiSmallMarginBottom">
          <Label id="searchLabel" text="{i18n>searchLabel}" labelFor="searchField" />
          <SearchField
            id="searchField"
            width="100%"
            enabled="{ui>/actionsEnabled}"
            placeholder="{i18n>searchPlaceholder}"
            liveChange=".onSearch" />
        </VBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <VBox id="contentArea">
        <IllustratedMessage
          id="stateMessage"
          visible="{ui>/messageVisible}"
          illustrationType="{ui>/illustrationType}"
          title="{ui>/messageTitle}"
          description="{ui>/messageDescription}"
          enableVerticalResponsiveness="true">
          <additionalContent>
            <Button id="retryButton" text="{i18n>retryButtonText}" visible="{ui>/retryVisible}" press=".onRefresh" />
          </additionalContent>
        </IllustratedMessage>
        <Table
          id="itemsTable"
          ariaLabelledBy="tableTitle"
          visible="{ui>/tableVisible}"
          busy="{ui>/busy}"
          busyIndicatorDelay="0"
          items="{sample>/items}"
          growing="true"
          growingThreshold="20"
          noDataText="{ui>/noDataText}">
          <headerToolbar>
            <OverflowToolbar id="tableToolbar">
              <Title id="tableTitle" text="{i18n>tableTitle}" level="H2" />
              <ToolbarSpacer />
              <Button
                id="refreshButton"
                icon="sap-icon://refresh"
                tooltip="{i18n>refreshTooltip}"
                type="Transparent"
                press=".onRefresh" />
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column id="idColumn" width="9rem">
              <Text text="{i18n>idColumn}" />
            </Column>
            <Column id="nameColumn" minScreenWidth="Tablet" demandPopin="true">
              <Text text="{i18n>nameColumn}" />
            </Column>
            <Column id="ownerColumn" minScreenWidth="Desktop" demandPopin="true">
              <Text text="{i18n>ownerColumn}" />
            </Column>
            <Column id="statusColumn" hAlign="End" width="10rem">
              <Text text="{i18n>statusColumn}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem id="itemTemplate" type="Navigation" press=".onItemPress">
              <cells>
                <ObjectIdentifier title="{sample>id}" />
                <Text text="{sample>name}" />
                <Text text="{sample>owner}" />
                <ObjectStatus text="{sample>statusText}" state="{sample>statusState}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
